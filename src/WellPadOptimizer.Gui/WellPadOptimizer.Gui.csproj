<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- позволяет собирать (но не запускать) WPF-проект на Linux, например в GitHub Actions -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WellPadOptimizer.Gui</RootNamespace>
    <AssemblyName>WellPadOptimizerGui</AssemblyName>
    <Version>2.0.0</Version>
    <Product>WellPadOptimizer</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WellPadOptimizer.Core\WellPadOptimizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\settings.json" Link="settings.json" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\data\**\*" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
