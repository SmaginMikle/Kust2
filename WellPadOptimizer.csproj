<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WellPadOptimizer</RootNamespace>
    <AssemblyName>WellPadOptimizer</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Version>1.0.0</Version>
    <Product>WellPadOptimizer</Product>
    <Description>Кустование скважин, расчёт траекторий и затрат</Description>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="report_template.html" LogicalName="report_template.html" />
    <None Include="settings.json" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="data\**\*" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
